{
  "name": "zcode-assistant",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "description": "zcode 使用增强工具：配额监控、模型管理、自动切换、悬浮球、账号切换",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-version.mjs && vue-tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:ts": "vue-tsc --noEmit",
    "version:sync": "node scripts/sync-version.mjs",
    "icon:gen": "node scripts/generate-icon.mjs",
    "release:gitee": "node scripts/publish-gitee-release.mjs",
    "release:github": "node scripts/publish-github-release.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2",
    "element-plus": "^2.14.5",
    "markdown-it": "^14.1.0",
    "myui": "git+https://gitee.com/argustang/my-ui.git#v0.18.0",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.10"
  }
}
